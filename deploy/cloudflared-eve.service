[Unit]
Description=Cloudflare Tunnel: db.mahesh.lol -> eve dashboard
After=network-online.target eve-dashboard.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run eve-dashboard
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
