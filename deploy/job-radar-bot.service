[Unit]
Description=job-radar Discord bot (drains the events queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/job-radar
EnvironmentFile=%h/job-radar/.env
ExecStart=/usr/bin/node src/bot.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
