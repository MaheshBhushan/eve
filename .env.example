DISCORD_TOKEN=...
# Only needed if --register cannot derive it from the token
#DISCORD_APP_ID=...
DISCORD_CHANNEL_ID=...
RADAR_DB=/home/maheshk/eve/eve.db

# --- Fit scoring -----------------------------------------------------------
# Path to job-pipeline's profile.json. Read-only, and read by PATH on purpose:
# job-pipeline owns the file, so there is one source of truth about you and no
# code coupling between the two projects. Unset disables scoring, and the
# high-fit alert along with it.
RADAR_PROFILE=/run/media/maheshk/New Volume/MK-solutions/job-pipeline/profile.json
RADAR_FIT_MODEL=sonnet
# Score at or above this pings you
RADAR_FIT_THRESHOLD=75
# A posting only counts as "fresh" this many hours after the board published it.
# Boards that state no publish date can never fire the freshness alert at all.
RADAR_FRESH_HOURS=48
# Max LLM scorings per poll cycle
RADAR_FIT_BUDGET=25

# --- Alerts and sweeps -----------------------------------------------------
# Discord user id to ping on alerts; omit for @here
#RADAR_PING=123456789012345678
RADAR_DIGEST_THRESHOLD=5
# Claimed but not applied for this many days -> a nudge
RADAR_STALE_DAYS=7
# Ping this many days before a stated application deadline
RADAR_DEADLINE_DAYS=3

# --- Safety ----------------------------------------------------------------
# Consecutive poll failures before a board is muted
RADAR_MAX_FAILURES=5
# Refuse a snapshot that loses more than this fraction of a board in one cycle.
# A board erroring out mid-pagination looks exactly like a mass delisting.
RADAR_MASS_DELIST_RATIO=0.5

# --- Filtering -------------------------------------------------------------
# Config-driven snapshot filter: which postings are worth tracking at all.
# Unset (the default) means no filtering -- every posting on every watched board
# is stored, which on a query-shaped board like Arbeitsagentur is tens of
# thousands of rows. Copy config/filters.example.json, which ships a
# Werkstudent / Praktikum / thesis default for Germany, and edit it: locations,
# role vocabulary and per-source overrides are all data, never code.
# A file that exists but is malformed is a hard error, not a silent fallback.
# Editing it re-baselines the affected sources on the next poll (rows refreshed,
# nothing closed, no closure alerts) because filters run before the diff.
#RADAR_FILTERS=/home/maheshk/eve/config/filters.json
# Copy config/filters.example.json -> config/filters.json and edit it. Unset
# means NO filtering: every posting on every watched board is tracked and
# scored. config/boards.example.json is a verified starting set of sources;
# seed it with: node scripts/seed-boards.ts config/boards.json

# --- Browser-driven sources (LinkedIn / Indeed / StepStone) ----------------
# Opt-in and off by default. Scraping these sites may violate their terms and
# can get an account rate-limited or flagged. Leave unset to disable.
# These sources are NOT complete snapshots -- search pages are ranked and
# paginated, so the poller never infers a closure from a posting's absence in
# them. New postings, high-fit and deadline alerts still work.
#RADAR_BROWSER_USE_DIR=/run/media/maheshk/New Volume/MK-solutions/browser-use
# The checkout above ships no venv. Create one:
#   python3 -m venv .venv && .venv/bin/pip install browser-use && .venv/bin/playwright install chromium
#RADAR_BROWSER_USE_PYTHON=/run/media/maheshk/New Volume/MK-solutions/browser-use/.venv/bin/python
#RADAR_BROWSER_TIMEOUT_MIN=10
# LLM driving the browser agent: an OpenAI-compatible gateway, or ANTHROPIC_API_KEY
#RADAR_BROWSER_API_KEY=sk-...
#RADAR_BROWSER_BASE_URL=https://llm.safzan.dev/v1
#RADAR_BROWSER_MODEL=deepseek-v4-flash
# browser-use otherwise sends temperature=null, which some gateways reject with a 400
#RADAR_BROWSER_TEMPERATURE=0.2
#RADAR_BROWSER_HEADLESS=true
# Persistent profile -- a logged-out LinkedIn search is mostly a login wall
#RADAR_BROWSER_USER_DATA_DIR=/home/maheshk/.config/eve-browser

# --- Dashboard ---------------------------------------------------------------
# Live job dashboard (node src/dashboard.ts). Loopback-only by default.
#RADAR_DASHBOARD_PORT=8787
#RADAR_DASHBOARD_BIND=127.0.0.1
